        } else {
          playPauseIcon.innerHTML = '<polygon points="6,4 20,12 6,20"></polygon>';
          playPauseText.textContent = currentTime > 0 && currentTime < DURATION ? "Resume" : "Play";
        }
      }

      function stopAnimationLoop() {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      }

      function tick(now) {
        if (!isPlaying) return;

        const dt = clamp((now - lastFramePerf) / 1000, 0.001, 0.1);
        lastFramePerf = now;

        if (isExporting && now - lastExportFramePerf < EXPORT_FRAME_MS - 1.5) {
          rafId = requestAnimationFrame(tick);
          return;
        }
        lastExportFramePerf = now;

        if (audioEngine.isInitialized && audioEngine.ctx && audioEngine.ctx.state === "running") {
          currentTime = timelineClockBase + (audioEngine.ctx.currentTime - audioClockBase);
        } else {
          currentTime += dt;
        }

        if (currentTime >= DURATION) {
          currentTime = DURATION;
          renderer.renderFrame(currentTime);
          audioEngine.stopBuffer();
          updateUIForTime(currentTime, true);

          if (isExporting) {
            exportProgressFill.style.width = "100%";
            exportPctMsg.textContent = "100%";
            finishVideoExport();
          } else {
            pausePlayback(true);
          }
          return;
        }

        renderer.renderFrame(currentTime);
        audioEngine.updateDiscreteCues(currentTime, true);

        frameCounter++;
        fpsAccumTime += dt;
        if (fpsAccumTime >= 0.45) {
          const cap = isExporting ? EXPORT_FPS : 60;
          const fps = Math.min(cap, Math.round(frameCounter / fpsAccumTime));
          fpsReadout.textContent = `${fps} FPS · LIVE`;
          frameCounter = 0;
          fpsAccumTime = 0;
        }

        if (now - lastUiUpdatePerf >= 45) {
          lastUiUpdatePerf = now;
          updateUIForTime(currentTime, false);
          if (isExporting) {
            const pct = Math.min(100, Math.round((currentTime / DURATION) * 100));
            exportProgressFill.style.width = `${pct}%`;
            exportPctMsg.textContent = `${pct}%`;
            exportStatusMsg.textContent = `Recording (${currentTime.toFixed(1)}s / ${DURATION.toFixed(1)}s)...`;
          }
        }

        rafId = requestAnimationFrame(tick);
      }

      async function startPlayback(fromStart = false) {
        await audioEngine.init();
        if (fromStart || currentTime >= DURATION - 0.05) {
          currentTime = 0.0;
        }

        if (audioEngine.ctx) {
          audioClockBase = audioEngine.ctx.currentTime;
          timelineClockBase = currentTime;
          audioEngine.startBufferAt(currentTime);
        }

        isPlaying = true;
        setPlayButtonState(true);
        if (!isExporting) {
          engineStatePill.classList.remove("recording");
          engineStateLabel.textContent = "PLAYING · 35.0S";
        }

        lastFramePerf = performance.now();
        lastExportFramePerf = 0;
        stopAnimationLoop();
        rafId = requestAnimationFrame(tick);
      }

      function pausePlayback(endedNaturally = false) {
        if (isExporting) return;
        isPlaying = false;
        stopAnimationLoop();
        audioEngine.stopBuffer();
        setPlayButtonState(false);
        updateUIForTime(currentTime, true);
        engineStateLabel.textContent = endedNaturally ? "COMPLETED · 35.00S" : "PAUSED";
      }

      function detectBestExportCodec() {
        if (typeof MediaRecorder === "undefined") return { mimeType: "", ext: "webm" };
        const candidates = [
          { mimeType: "video/mp4;codecs=avc1.42E01E,mp4a.40.2", ext: "mp4" },
          { mimeType: "video/mp4", ext: "mp4" },
          { mimeType: "video/webm;codecs=vp9,opus", ext: "webm" },
          { mimeType: "video/webm;codecs=vp8,opus", ext: "webm" },
          { mimeType: "video/webm", ext: "webm" }
        ];
        for (let i = 0; i < candidates.length; i++) {
          if (MediaRecorder.isTypeSupported(candidates[i].mimeType)) {
            return candidates[i];
          }
        }
        return { mimeType: "", ext: "webm" };
      }

      async function startVideoExport() {
        if (isExporting) return;
        await audioEngine.init();

        const codecInfo = detectBestExportCodec();
        if (!codecInfo.mimeType || typeof canvas.captureStream !== "function") {
          exportStatusMsg.textContent = "MediaRecorder is not supported in this browser.";
          return;
        }

        if (currentBlobUrl) {
          URL.revokeObjectURL(currentBlobUrl);
          currentBlobUrl = null;
        }
        downloadVideoLink.classList.remove("ready");

        isExporting = true;
        exportVideoBtn.disabled = true;
        replayBtn.disabled = true;
        timelineScrubber.disabled = true;
        exportBtnText.textContent = "Recording 35.0s...";
        engineStatePill.classList.add("recording");
        engineStateLabel.textContent = `REC · 1920×1080 (${codecInfo.ext.toUpperCase()})`;

        currentTime = 0.0;
        renderer.renderFrame(0.0);

        const canvasStream = canvas.captureStream(EXPORT_FPS);
        const audioTracks = audioEngine.exportDest ? audioEngine.exportDest.stream.getAudioTracks() : [];
        const combinedStream = new MediaStream([...canvasStream.getVideoTracks(), ...audioTracks]);

        const recordedChunks = [];
        try {
          activeMediaRecorder = new MediaRecorder(combinedStream, {
            mimeType: codecInfo.mimeType,
            videoBitsPerSecond: 8000000,
            audioBitsPerSecond: 160000
          });
        } catch (_) {
          activeMediaRecorder = new MediaRecorder(combinedStream);
        }

        activeMediaRecorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) recordedChunks.push(e.data);
        };

        activeMediaRecorder.onstop = () => {
          const blob = new Blob(recordedChunks, { type: codecInfo.mimeType || "video/webm" });
          currentBlobUrl = URL.createObjectURL(blob);
          const sizeMB = (blob.size / (1024 * 1024)).toFixed(2);
          const fileName = `gemini_4_argon_35s.${codecInfo.ext}`;

          downloadVideoLink.href = currentBlobUrl;
          downloadVideoLink.download = fileName;
          downloadBtnText.textContent = `Download Video (${sizeMB} MB .${codecInfo.ext})`;
          downloadVideoLink.classList.add("ready");

          exportStatusMsg.textContent = `Complete (${sizeMB} MB · 35.0s · 1920×1080 + Audio)`;
          exportPctMsg.textContent = "100%";

          isExporting = false;
          exportVideoBtn.disabled = false;
          replayBtn.disabled = false;
          timelineScrubber.disabled = false;
          exportBtnText.textContent = "Export Video (35.0s)";
          engineStatePill.classList.remove("recording");
          engineStateLabel.textContent = "EXPORT READY · 35.0S";
          canvasStream.getVideoTracks().forEach((t) => t.stop());
          downloadVideoLink.click();
        };

        activeMediaRecorder.start(400);
        await startPlayback(true);
      }

      function finishVideoExport() {
        isPlaying = false;
        stopAnimationLoop();
        audioEngine.stopBuffer();
        setPlayButtonState(false);

        if (activeMediaRecorder && activeMediaRecorder.state !== "inactive") {
          try { activeMediaRecorder.requestData(); } catch (_) {}
          setTimeout(() => {
            if (activeMediaRecorder && activeMediaRecorder.state !== "inactive") {
              activeMediaRecorder.stop();
            }
          }, 120);
        }
      }

      overlayPlayBtn.addEventListener("click", () => startPlayback(true));

      playPauseBtn.addEventListener("click", () => {
        if (isExporting) return;
        if (isPlaying) pausePlayback(false);
        else startPlayback(currentTime >= DURATION - 0.05);
      });

      replayBtn.addEventListener("click", () => {
        if (isExporting) return;
        startPlayback(true);
      });

      timelineScrubber.addEventListener("input", (e) => {
        if (isExporting) return;
        currentTime = clamp(parseFloat(e.target.value), 0.0, DURATION);
        if (isPlaying && audioEngine.ctx) {
          audioClockBase = audioEngine.ctx.currentTime;
          timelineClockBase = currentTime;
          audioEngine.startBufferAt(currentTime);
        }
        renderer.renderFrame(currentTime);
        updateUIForTime(currentTime, true);
      });

      sceneTicks.forEach((btn) => {
        btn.addEventListener("click", () => {
          if (isExporting) return;
          currentTime = clamp(parseFloat(btn.getAttribute("data-scene-start") || "0"), 0, DURATION);
          if (isPlaying && audioEngine.ctx) {
            audioClockBase = audioEngine.ctx.currentTime;
            timelineClockBase = currentTime;
            audioEngine.startBufferAt(currentTime);
          }
          renderer.renderFrame(currentTime);
          updateUIForTime(currentTime, true);
        });
      });

      storyboardRows.forEach((row) => {
        row.addEventListener("click", () => {
          if (isExporting) return;
          currentTime = clamp(parseFloat(row.getAttribute("data-jump") || "0"), 0, DURATION);
          if (isPlaying && audioEngine.ctx) {
            audioClockBase = audioEngine.ctx.currentTime;
            timelineClockBase = currentTime;
            audioEngine.startBufferAt(currentTime);
          }
          renderer.renderFrame(currentTime);
          updateUIForTime(currentTime, true);
        });
      });

      muteToggleBtn.addEventListener("click", () => {
        audioEngine.init();
        const nextMute = !audioEngine.isMuted;
        audioEngine.setMute(nextMute);
        muteBtnText.textContent = nextMute ? "Unmute" : "Mute";
        volumePctText.textContent = nextMute ? "MUTE" : `${Math.round(audioEngine.userVolume * 100)}%`;
      });

      volumeSlider.addEventListener("input", (e) => {
        audioEngine.init();
        const v = parseFloat(e.target.value);
        audioEngine.setVolume(v);
        if (audioEngine.isMuted && v > 0) {
          audioEngine.setMute(false);
          muteBtnText.textContent = "Mute";
        }
        volumePctText.textContent = `${Math.round(v * 100)}%`;
      });

      exportVideoBtn.addEventListener("click", () => startVideoExport());

      const bestCodec = detectBestExportCodec();
      if (bestCodec.mimeType) {
        codecBadge.textContent = `${bestCodec.ext.toUpperCase()} · 35.0S`;
      }

      // Render initial poster frame at 3.5s showing the glowing particle numeral "4" and "Gemini 4 Argon"
      renderer.renderFrame(3.5);
      updateUIForTime(0.0, true);
    })();
  </script>
</body>
