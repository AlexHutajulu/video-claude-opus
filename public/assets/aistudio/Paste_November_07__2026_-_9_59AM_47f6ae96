        async init() {
          if (this.isInitialized && this.ctx) {
            if (this.ctx.state === "suspended") {
              try { await this.ctx.resume(); } catch (_) {}
            }
            return;
          }

          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioCtx();

          this.masterGain = this.ctx.createGain();
          this.masterGain.gain.setValueAtTime(1.0, this.ctx.currentTime);

          this.exportDest = this.ctx.createMediaStreamDestination();

          this.monitorGain = this.ctx.createGain();
          this.monitorGain.gain.setValueAtTime(this.isMuted ? 0 : this.userVolume, this.ctx.currentTime);

          this.masterGain.connect(this.exportDest);
          this.masterGain.connect(this.monitorGain);
          this.monitorGain.connect(this.ctx.destination);

          // Pre-generate a clean 1.0s pink-noise buffer for soft transition whooshes
          const rate = this.ctx.sampleRate;
          const len = Math.floor(rate * 1.0);
          this.noiseBuffer = this.ctx.createBuffer(1, len, rate);
          const data = this.noiseBuffer.getChannelData(0);
          const rng = mulberry32(777);
          let b0 = 0, b1 = 0, b2 = 0;
          for (let i = 0; i < len; i++) {
            const w = rng() * 2 - 1;
            b0 = 0.99 * b0 + w * 0.1;
            b1 = 0.96 * b1 + w * 0.15;
            b2 = 0.85 * b2 + w * 0.25;
            data[i] = (b0 + b1 + b2) * 0.12;
          }

          try {
            const binary = atob(ORIGINAL_AUDIO_B64);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) {
              bytes[i] = binary.charCodeAt(i);
            }
            this.audioBuffer = await this.ctx.decodeAudioData(bytes.buffer);
          } catch (_) {
            this.audioBuffer = null;
          }

          this.isInitialized = true;
          if (this.ctx.state === "suspended") {
            try { await this.ctx.resume(); } catch (_) {}
          }
        }

        startBufferAt(offsetSec) {
          this.stopBuffer();
          this.triggeredCues.clear();
          this.lastTimelinePos = offsetSec;
          if (!this.ctx || !this.audioBuffer) return;

          if (offsetSec < this.audioBuffer.duration - 0.1) {
            const src = this.ctx.createBufferSource();
            src.buffer = this.audioBuffer;
            src.connect(this.masterGain);
            src.start(0, clamp(offsetSec, 0, this.audioBuffer.duration - 0.05));
            this.activeSource = src;
          }
        }

        updateDiscreteCues(t, isPlaying) {
          if (!this.isInitialized || !this.ctx || !isPlaying) return;

          if (t < this.lastTimelinePos - 0.25) {
            this.triggeredCues.clear();
          }
          for (let i = 0; i < this.cues.length; i++) {
            const cue = this.cues[i];
            if (t >= cue.time && t - cue.time < 0.28 && !this.triggeredCues.has(cue.id)) {
              this.triggeredCues.add(cue.id);
              cue.fn();
            }
          }
          this.lastTimelinePos = t;
        }

        playKeyTick(freq, peak) {
          if (!this.ctx) return;
          const now = this.ctx.currentTime;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = "sine";
          osc.frequency.setValueAtTime(freq, now);
          osc.frequency.exponentialRampToValueAtTime(freq * 0.6, now + 0.045);
          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.linearRampToValueAtTime(peak, now + 0.004);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.05);
          osc.connect(gain);
          gain.connect(this.masterGain);
          osc.start(now);
          osc.stop(now + 0.055);
        }

        playUiPop(f1, f2, peak) {
          if (!this.ctx) return;
          const now = this.ctx.currentTime;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = "sine";
          osc.frequency.setValueAtTime(f1, now);
          osc.frequency.exponentialRampToValueAtTime(f2, now + 0.085);
          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.linearRampToValueAtTime(peak, now + 0.008);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.14);
          osc.connect(gain);
          gain.connect(this.masterGain);
          osc.start(now);
          osc.stop(now + 0.15);
        }

        playSoftChime(freqs, duration, peak) {
          if (!this.ctx) return;
          const now = this.ctx.currentTime;
          const filter = this.ctx.createBiquadFilter();
          filter.type = "lowpass";
          filter.frequency.setValueAtTime(1800, now);
          filter.frequency.exponentialRampToValueAtTime(420, now + duration);

          const gain = this.ctx.createGain();
          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.linearRampToValueAtTime(peak, now + 0.04);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

          filter.connect(gain);
          gain.connect(this.masterGain);

          freqs.forEach((f) => {
            const osc = this.ctx.createOscillator();
            osc.type = "sine";
            osc.frequency.setValueAtTime(f, now);
            osc.connect(filter);
            osc.start(now);
            osc.stop(now + duration + 0.04);
          });
        }

        playSoftWhoosh(duration, lowF, highF, peak) {
          if (!this.ctx || !this.noiseBuffer) return;
          const now = this.ctx.currentTime;
          const src = this.ctx.createBufferSource();
          src.buffer = this.noiseBuffer;

          const filter = this.ctx.createBiquadFilter();
          filter.type = "bandpass";
          filter.Q.setValueAtTime(2.2, now);
          filter.frequency.setValueAtTime(lowF, now);
          filter.frequency.exponentialRampToValueAtTime(highF, now + duration * 0.5);
          filter.frequency.exponentialRampToValueAtTime(lowF * 0.8, now + duration);

          const gain = this.ctx.createGain();
          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.linearRampToValueAtTime(peak, now + duration * 0.45);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

          src.connect(filter);
          filter.connect(gain);
          gain.connect(this.masterGain);
          src.start(now);
          src.stop(now + duration + 0.04);
        }

        stopBuffer() {
          if (this.activeSource) {
            try { this.activeSource.stop(); } catch (_) {}
            try { this.activeSource.disconnect(); } catch (_) {}
            this.activeSource = null;
          }
        }

        setVolume(val) {
          this.userVolume = clamp(val, 0, 1);
          if (this.monitorGain && this.ctx && !this.isMuted) {
            this.monitorGain.gain.setTargetAtTime(this.userVolume, this.ctx.currentTime, 0.02);
          }
        }

        setMute(muted) {
          this.isMuted = Boolean(muted);
          if (this.monitorGain && this.ctx) {
            this.monitorGain.gain.setTargetAtTime(this.isMuted ? 0 : this.userVolume, this.ctx.currentTime, 0.02);
          }
        }
      }

