      --font-sans: "Google Sans", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --font-mono: "JetBrains Mono", "SF Mono", Consolas, monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      min-height: 100vh;
      background-color: var(--bg-void);
      color: var(--text-white);
      font-family: var(--font-sans);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      user-select: none;
    }

    .studio-shell {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      max-width: 1620px;
      margin: 0 auto;
      padding: 14px 20px 20px;
      gap: 14px;
    }

    /* TOP HEADER */
    .top-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      padding: 12px 20px;
      background: var(--bg-panel);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
    }

    .brand-cluster {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-emblem {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: radial-gradient(circle at 30% 30%, rgba(56, 189, 248, 0.28), rgba(14, 17, 23, 0.95));
      border: 1px solid rgba(56, 189, 248, 0.48);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .brand-emblem svg {
      width: 22px;
      height: 22px;
    }

    .brand-titles {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .brand-main-title {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: var(--text-white);
      text-transform: uppercase;
    }

    .brand-sub-title {
      font-size: 11.5px;
      color: var(--text-muted);
    }

    .header-telemetry {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .telemetry-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 12px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--text-Light);
    }

    .telemetry-pill .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent-cyan);
    }

    .telemetry-pill.recording .dot {
      background: var(--status-rec);
    }

    /* MAIN WORKSPACE */
    .workspace-grid {
      display: grid;
      grid-template-columns: 1fr 370px;
      gap: 16px;
      flex: 1;
      align-items: stretch;
    }

    .stage-column {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-width: 0;
    }

    .viewport-wrapper {
      position: relative;
      flex: 1;
      min-height: 460px;
      background: #080a0f;
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      overflow: hidden;
    }

    .canvas-frame-container {
      position: relative;
      aspect-ratio: 16 / 9;
      width: min(100%, 1080px);
      max-height: 68vh;
      border-radius: 12px;
      overflow: hidden;
      background: #040507;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.85);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #stageCanvas {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: contain;
    }

    .stage-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: rgba(5, 6, 8, 0.78);
      z-index: 10;
      transition: opacity 0.25s ease, visibility 0.25s;
      padding: 24px;
      text-align: center;
    }

    .stage-overlay.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      display: none;
    }

    .launch-play-btn {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 16px 32px;
      border-radius: 999px;
      border: 1px solid rgba(125, 211, 252, 0.7);
      background: linear-gradient(135deg, #0284c7 0%, #4f46e5 100%);
      color: #ffffff;
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 12px 35px rgba(37, 99, 235, 0.45);
      transition: transform 0.18s ease;
    }

    .launch-play-btn:hover {
      transform: translateY(-2px);
    }

    .launch-play-btn svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    .overlay-caption {
      margin-top: 14px;
      font-size: 12px;
      color: var(--text-Light);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .overlay-sub {
      margin-top: 5px;
      font-size: 11.5px;
      color: var(--text-muted);
      max-width: 390px;
      line-height: 1.45;
    }

    .viewport-badge {
      position: absolute;
      top: 14px;
      left: 16px;
      padding: 5px 10px;
      background: rgba(14, 17, 23, 0.88);
      border: 1px solid var(--border-subtle);
      border-radius: 6px;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
      pointer-events: none;
    }

    .viewport-scene-pill {
      position: absolute;
      top: 14px;
      right: 16px;
      padding: 5px 11px;
      background: rgba(14, 17, 23, 0.9);
      border: 1px solid rgba(56, 189, 248, 0.4);
      border-radius: 6px;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--accent-cyan);
      pointer-events: none;
    }

    /* TRANSPORT BAR */
    .transport-panel {
      background: var(--bg-panel);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 14px 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .timeline-scene-ticks {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 4px;
      font-family: var(--font-mono);
      font-size: 9.5px;
    }

    .scene-tick {
      padding: 5px 7px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 5px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--text-muted);
      overflow: hidden;
      white-space: nowrap;
    }

    .scene-tick:hover {
      border-color: var(--border-accent);
      color: var(--text-white);
    }

    .scene-tick.active {
      background: rgba(56, 189, 248, 0.16);
      border-color: var(--accent-cyan);
      color: var(--accent-cyan);
    }

    .timeline-slider {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 6px;
      border-radius: 999px;
      background: #262c3a;
      outline: none;
      cursor: pointer;
    }

    .timeline-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: #ffffff;
      border: 2px solid var(--accent-cyan);
      cursor: pointer;
    }

    .transport-controls-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .transport-left, .transport-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .ctrl-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 8px 15px;
      border-radius: 8px;
      border: 1px solid var(--border-subtle);
      background: var(--bg-card);
      color: var(--text-white);
      font-family: var(--font-sans);
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
    }

    .ctrl-btn:hover:not(:disabled) {
      background: var(--bg-elevated);
      border-color: var(--border-accent);
    }

    .ctrl-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .ctrl-btn.primary {
      background: linear-gradient(135deg, #0284c7 0%, #4f46e5 100%);
      border-color: rgba(125, 211, 252, 0.5);
    }

    .ctrl-btn svg {
      width: 15px;
      height: 15px;
      fill: currentColor;
    }

    .timecode-readout {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--text-Light);
      padding: 6px 12px;
      background: #080a0f;
      border: 1px solid var(--border-subtle);
      border-radius: 6px;
    }

    .timecode-readout span.dim {
      color: var(--text-dim);
    }

    .volume-cluster {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      padding: 5px 12px;
      border-radius: 8px;
    }

    .volume-slider {
      -webkit-appearance: none;
      appearance: none;
      width: 84px;
      height: 4px;
      border-radius: 999px;
      background: #2d3546;
      outline: none;
      cursor: pointer;
    }

    .volume-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: var(--accent-cyan);
      cursor: pointer;
    }

    .volume-pct {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
      min-width: 34px;
      text-align: right;
    }

    /* RIGHT SIDEBAR */
    .inspector-panel {
      background: var(--bg-panel);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    .panel-section {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .panel-section:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .section-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .section-heading .accent-tag {
      color: var(--accent-cyan);
      font-family: var(--font-mono);
      font-size: 10px;
    }

    .specs-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 7px;
    }

    .spec-item {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 7px 10px;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .spec-label {
      font-size: 9.5px;
      text-transform: uppercase;
      color: var(--text-dim);
    }

    .spec-value {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      color: var(--text-white);
    }

    .spec-value.cyan {
      color: var(--accent-cyan);
    }

    .storyboard-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .storyboard-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 5px 9px;
      border-radius: 6px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      font-size: 10.5px;
      cursor: pointer;
    }

    .storyboard-row.active {
      background: rgba(56, 189, 248, 0.15);
      border-color: var(--accent-cyan);
      color: var(--accent-cyan);
    }

    .export-card {
      background: #111621;
      border: 1px solid rgba(56, 189, 248, 0.38);
      border-radius: 10px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .export-btn {
      width: 100%;
      padding: 11px 16px;
      border-radius: 8px;
      border: 1px solid rgba(125, 211, 252, 0.65);
      background: linear-gradient(135deg, #0284c7 0%, #4f46e5 100%);
      color: #ffffff;
      font-family: var(--font-sans);
      font-size: 12.5px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
    }

    .export-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .download-btn {
      width: 100%;
      padding: 10px 14px;
      border-radius: 8px;
      border: 1px solid rgba(16, 185, 129, 0.6);
      background: rgba(16, 185, 129, 0.16);
      color: #a7f3d0;
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
    }

    .download-btn.ready {
      display: flex;
    }

    .export-progress-bar-bg {
      width: 100%;
      height: 7px;
      background: #080a0f;
      border: 1px solid var(--border-subtle);
      border-radius: 999px;
      overflow: hidden;
    }

    .export-progress-bar-fill {
      width: 0%;
      height: 100%;
      background: linear-gradient(90deg, #0284c7, #38bdf8, #818cf8);
    }

    .export-status-text {
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--text-Light);
      display: flex;
      justify-content: space-between;
    }

    @media (max-width: 1080px) {
      .workspace-grid {
        grid-template-columns: 1fr;
      }
      .timeline-scene-ticks {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</head>
