        renderScene06DocumentReveal(ctx, time, weight) {
          const localT = Math.max(0, time - 14.1);
          const exitSlide = smoothstep(17.1, 17.75, time);

          ctx.save();
          const revealRatio = clamp(localT / 0.85, 0.15, 1.0);
          const srcW = this.assets.docW;
          const srcH = this.assets.docH;

          const slices = 36;
          const baseScale = lerp(0.92, 1.0, easeOutCubic(clamp(localT / 0.45, 0.0, 1.0))) * (1.0 - exitSlide * 0.12);
          const cardTopY = 58 + exitSlide * -60;
          const cardTotalH = 965 * baseScale;

          for (let i = 0; i < slices; i++) {
            const u0 = i / slices;
            const sy = u0 * srcH;
            const sh = (srcH / slices) + 1.0;

            const perspectiveScale = lerp(0.91, 1.04, u0) * baseScale;
            const dw = srcW * perspectiveScale;
            const dx = CX - dw * 0.5;
            const dy = cardTopY + u0 * cardTotalH;
            const dh = (cardTotalH / slices) + 1.2;

            const sliceVis = smoothstep(u0 - 0.12, u0 + 0.02, revealRatio);
            ctx.globalAlpha = weight * lerp(0.18, 1.0, sliceVis);
            ctx.drawImage(this.assets.docCanvas, 0, sy, srcW, sh, dx, dy, dw, dh);
          }

          ctx.restore();
        }

