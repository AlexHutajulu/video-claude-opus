          }

          if (time >= 8.85 && time <= 10.95) {
            const dragProg = easeOutCubic(clamp((time - 8.85) / 1.45, 0.0, 1.0));
            const docAlpha = (1.0 - smoothstep(10.55, 10.95, time)) * smoothstep(8.85, 9.15, time) * weight;
