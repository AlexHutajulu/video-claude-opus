<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>GEMINI — Video Recreation (HTML · 22.33s · 16:9)</title>
<style>
  :root {
    --bg-void: #0b0b0d; --bg-panel: #141416; --bg-card: #1b1b1e; --border-subtle: #2b2b30;
    --text-ivory: #f5f2eb; --text-cream: #e8e2d5; --text-muted: #9e9589;
    --accent-blue: #4285f4; --accent-red: #ea4335; --accent-yellow: #fbbc04; --accent-green: #34a853;
    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", "Plus Jakarta Sans", Arial, sans-serif;
    --font-mono: "JetBrains Mono", "SF Mono", Consolas, monospace;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 100%; min-height: 100vh; background: var(--bg-void); color: var(--text-ivory); font-family: var(--font-sans); -webkit-font-smoothing: antialiased; }
  .shell { max-width: 1180px; margin: 0 auto; padding: 14px 18px 22px; display: flex; flex-direction: column; gap: 12px; }
  .top-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 12px 18px; background: var(--bg-panel); border: 1px solid var(--border-subtle); border-radius: 12px; }
  .brand-main { font-size: 14px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .brand-sub { font-size: 11px; color: var(--text-muted); letter-spacing: .04em; }
  .pill { display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: 999px; font-family: var(--font-mono); font-size: 11.5px; color: var(--text-cream); }
  .pill .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-blue); }
  .stage { background: #0c0c0e; border: 1px solid var(--border-subtle); border-radius: 14px; padding: 16px; display: flex; justify-content: center; }
  .canvas-frame { position: relative; width: 100%; max-width: 1024px; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; background: #fff; border: 1px solid rgba(255,255,255,.12); }
  canvas { width: 100%; height: 100%; display: block; }
  .transport { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 12px 16px; background: var(--bg-panel); border: 1px solid var(--border-subtle); border-radius: 12px; }
  .btn { padding: 9px 16px; border-radius: 999px; border: 1px solid var(--border-subtle); background: var(--bg-card); color: var(--text-ivory); font-family: var(--font-sans); font-size: 13px; font-weight: 600; cursor: pointer; }
  .btn.primary { background: linear-gradient(135deg, #4285f4, #9b72cb 55%, #d96570); border-color: rgba(255,255,255,.35); }
  .btn:disabled { opacity: .5; cursor: not-allowed; }
  .btn.small { padding: 6px 11px; font-size: 12px; }
  input[type="range"].scrub { flex: 1; min-width: 160px; accent-color: #4285f4; }
  .time-label { font-family: var(--font-mono); font-size: 12px; color: var(--text-cream); }
  .scene-row { display: flex; gap: 8px; flex-wrap: wrap; padding: 12px 16px; background: var(--bg-panel); border: 1px solid var(--border-subtle); border-radius: 12px; }
  .scene-chip { padding: 6px 11px; border-radius: 999px; border: 1px solid var(--border-subtle); background: var(--bg-card); color: var(--text-cream); font-size: 12px; cursor: pointer; font-family: var(--font-sans); }
  .scene-chip.active { border-color: rgba(66,133,244,.7); color: #fff; background: #1d2b45; }
  .panel { padding: 14px 16px; background: var(--bg-panel); border: 1px solid var(--border-subtle); border-radius: 12px; }
  .panel h3 { font-size: 13px; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 8px; }
  .panel p { font-size: 13px; line-height: 1.65; color: var(--text-cream); }
  .panel p + p { margin-top: 6px; }
  .muted { color: var(--text-muted); }
  .export-card { display: flex; flex-direction: column; gap: 10px; }
  .export-btn { padding: 11px 16px; border-radius: 10px; border: 1px solid rgba(66,133,244,.6); background: linear-gradient(135deg, #1a73e8, #174ea6); color: #fff; font-size: 14px; font-weight: 700; cursor: pointer; font-family: var(--font-sans); }
  .export-btn.mp4 { background: linear-gradient(135deg, #2e7d5b, #1d5c40); border-color: rgba(169,240,201,.6); }
  .export-btn:disabled { opacity: .5; cursor: not-allowed; }
  .download-btn { display: none; padding: 11px 16px; border-radius: 10px; background: #1e8e5a; color: #fff; text-decoration: none; font-size: 14px; font-weight: 700; text-align: center; }
  .download-btn.ready { display: block; }
  .progress-bg { height: 8px; background: #26262b; border-radius: 999px; overflow: hidden; }
  .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #4285f4, #9b72cb, #d96570); border-radius: 999px; transition: width .15s linear; }
  .status { font-family: var(--font-mono); font-size: 11.5px; color: var(--text-muted); }
  .vol-row { display: flex; align-items: center; gap: 8px; }
  .vol-row input[type="range"] { width: 90px; accent-color: #4285f4; }
</style>
</head>
<body>
<div class="shell">
  <div class="top-header">
    <div>
      <div class="brand-main">Gemini — Video Recreation</div>
      <div class="brand-sub">Dibuat ulang dengan HTML Canvas · 22.33 detik · 1280×720 · 30 FPS</div>
    </div>
    <div class="pill"><span class="dot"></span><span id="enginePill">CANVAS 16:9 · 30 FPS</span></div>
  </div>

  <div class="stage">
    <div class="canvas-frame"><canvas id="stageCanvas" width="1280" height="720"></canvas></div>
  </div>

  <div class="transport">
    <button type="button" class="btn primary" id="playBtn">▶ Play</button>
    <button type="button" class="btn" id="replayBtn">↺ Replay</button>
    <input type="range" class="scrub" id="scrubber" min="0" max="22.33" step="0.01" value="0" />
    <span class="time-label" id="timeLabel">0.00s / 22.33s</span>
    <div class="vol-row">
      <button type="button" class="btn small" id="muteBtn">🔊 85%</button>
    </div>
  </div>

  <div class="scene-row" id="sceneRow"></div>

  <div class="panel">
    <h3>Tentang video ini</h3>
    <p>Rekreasi animasi video Gemini yang kamu kirim — urutan, teks, dan timing dibuat semirip mungkin dengan aslinya: intro "Gemini — Your personal assistant", kartu "Hi David", "Meet Gemini", integrasi Google Workspace, "Powerful video generation", "Gemini can listen", sampai penutup "Create · Write · Learn · With Gemini".</p>
    <p class="muted">Foto-foto kecil (anjing, sapi, pegunungan, steak) dan musiknya diambil dari video asli yang kamu kirim, jadi tampilannya sama. Logo digambar ulang secara sederhana sebagai bentuk bintang gradasi — bukan aset logo resmi Google.</p>
  </div>

  <div class="panel">
    <h3>Export Video</h3>
    <div class="export-card">
      <button type="button" class="export-btn" id="exportBtn">Export WebM Master (22.33s)</button>
      <a id="downloadWebm" class="download-btn" href="#top" download="gemini_recreation.webm">Download WebM</a>
      <button type="button" class="export-btn mp4" id="convertMp4Btn" disabled>Convert ke MP4 (H.264)</button>
      <a id="downloadMp4" class="download-btn" href="#top" download="gemini_recreation.mp4">Download MP4</a>
      <div class="progress-bg"><div class="progress-fill" id="progressFill"></div></div>
      <div class="status"><span id="statusMsg">Siap merekam 1280×720 30FPS + Audio</span> · <span id="pctMsg">0%</span></div>
      <p class="muted" style="font-size:12px;line-height:1.6">Master direkam sebagai WebM (VP9, 12 Mbps, 670 frame tepat 22.33 detik). MP4 dibuat dengan transcode ffmpeg.wasm dari master yang sama, bukan direkam langsung — supaya durasi tidak jadi 3 detik seperti bug MP4 MediaRecorder. Convert MP4 butuh internet sekali untuk memuat mesin ffmpeg (~31 MB).</p>
      <p class="muted" style="font-size:12px;line-height:1.6" id="mp4StatusMsg">Belum ada master WebM — export WebM dulu, lalu convert ke MP4 di sini.</p>
    </div>
  </div>
</div>

<script>
(function () {
  "use strict";

  /* ================= CONSTANTS ================= */
  const WIDTH = 1280, HEIGHT = 720, CX = 640, CY = 360;
  const DURATION = 22.33, EXPORT_FPS = 30, TOTAL_FRAMES = 670;
  const SAFE_X = 64, SAFE_W = WIDTH - SAFE_X * 2;

  // Aset dari video asli: 4 foto tile + musik (base64, disuntik saat build)
  const TILE_DOG_SRC = "__TILE_DOG__";
  const TILE_COW_SRC = "__TILE_COW__";
  const TILE_MOUNTAINS_SRC = "__TILE_MOUNTAINS__";
  const TILE_STEAK_SRC = "__TILE_STEAK__";
  const SOUNDTRACK_SRC = "__SOUNDTRACK__";
  const SOUNDTRACK_DURATION = 22.33;

  const SCENES = [
    { id: 1, name: "01 · Intro + Hi David", start: 0.0, end: 2.0 },
    { id: 2, name: "02 · Ask Gemini", start: 2.0, end: 3.2 },
    { id: 3, name: "03 · Meet Gemini", start: 3.2, end: 5.8 },
    { id: 4, name: "04 · App Icon", start: 5.8, end: 7.2 },
    { id: 5, name: "05 · Workspace", start: 7.2, end: 9.0 },
    { id: 6, name: "06 · Video Generation", start: 9.0, end: 12.6 },
    { id: 7, name: "07 · Gemini Can Listen", start: 12.6, end: 15.2 },
    { id: 8, name: "08 · Create · Write · Learn", start: 15.2, end: 22.33 }
  ];

  /* ================= HELPERS ================= */
  function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }
  function lerp(a, b, t) { return a + (b - a) * t; }
  function smoothstep(a, b, x) { const t = clamp((x - a) / (b - a), 0, 1); return t * t * (3 - 2 * t); }
  function easeOutCubic(t) { t = clamp(t, 0, 1); return 1 - Math.pow(1 - t, 3); }
  function easeOutQuint(t) { t = clamp(t, 0, 1); return 1 - Math.pow(1 - t, 5); }
  function easeOutBack(t) { t = clamp(t, 0, 1); const c = 1.70158; return 1 + (c + 1) * Math.pow(t - 1, 3) + c * Math.pow(t - 1, 2); }

  function roundRectPath(ctx, x, y, w, h, r) {
    r = Math.min(r, w / 2, h / 2);
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  // Teks dengan letter-spacing (canvas tidak punya tracking bawaan)
  function drawTrackedText(ctx, text, cx, y, tracking, fillStyle, font, align) {
    ctx.save();
    ctx.font = font;
    ctx.textBaseline = "middle";
    ctx.fillStyle = fillStyle;
    const widths = [];
    let total = 0;
    for (let i = 0; i < text.length; i++) {
      const w = ctx.measureText(text[i]).width;
      widths.push(w); total += w;
    }
    total += tracking * Math.max(0, text.length - 1);
    let x = align === "left" ? cx : align === "right" ? cx - total : cx - total / 2;
    ctx.textAlign = "left";
    for (let i = 0; i < text.length; i++) {
      ctx.fillText(text[i], x, y);
      x += widths[i] + tracking;
    }
    ctx.restore();
  }

  function rainbowGradient(ctx, x0, y0, x1, y1) {
    const g = ctx.createLinearGradient(x0, y0, x1, y1);
    g.addColorStop(0.0, "#4285f4"); g.addColorStop(0.22, "#9b72cb");
    g.addColorStop(0.42, "#d96570"); g.addColorStop(0.62, "#fbbc04");
    g.addColorStop(0.82, "#34a853"); g.addColorStop(1.0, "#4285f4");
    return g;
  }

  // Bintang 4-sisi (sparkle) dengan gradasi pelangi
  function drawSparkle(ctx, x, y, r, alpha, rot) {
    if (alpha <= 0.01) return;
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(rot || 0);
    ctx.globalAlpha = alpha;
    const g = ctx.createLinearGradient(-r, -r, r, r);
    g.addColorStop(0, "#4285f4"); g.addColorStop(0.3, "#a142f5");
    g.addColorStop(0.55, "#ea4335"); g.addColorStop(0.8, "#fbbc04"); g.addColorStop(1, "#34a853");
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.moveTo(0, -r);
    ctx.quadraticCurveTo(r * 0.16, -r * 0.16, r, 0);
    ctx.quadraticCurveTo(r * 0.16, r * 0.16, 0, r);
    ctx.quadraticCurveTo(-r * 0.16, r * 0.16, -r, 0);
    ctx.quadraticCurveTo(-r * 0.16, -r * 0.16, 0, -r);
    ctx.fill();
    ctx.restore();
  }

  function softBlob(ctx, x, y, r, color, alpha) {
    const g = ctx.createRadialGradient(x, y, 0, x, y, r);
    g.addColorStop(0, color);
    g.addColorStop(1, "rgba(255,255,255,0)");
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
  }

  function shadowCard(ctx, x, y, w, h, r, fill, alpha) {
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.shadowColor = "rgba(60,64,67,0.28)";
    ctx.shadowBlur = 28; ctx.shadowOffsetY = 10;
    roundRectPath(ctx, x, y, w, h, r);
    ctx.fillStyle = fill; ctx.fill();
    ctx.restore();
  }

  function drawPhotoTile(ctx, img, x, y, w, h, r, alpha) {
    if (!img || !img.complete || !img.naturalWidth || alpha <= 0.01) return;
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.shadowColor = "rgba(60,64,67,0.25)";
    ctx.shadowBlur = 18; ctx.shadowOffsetY = 6;
    roundRectPath(ctx, x, y, w, h, r);
    ctx.fillStyle = "#e8eaed"; ctx.fill();
    ctx.shadowColor = "transparent"; ctx.shadowBlur = 0; ctx.shadowOffsetY = 0;
    ctx.clip();
    const iw = img.naturalWidth, ih = img.naturalHeight;
    const s = Math.max(w / iw, h / ih);
    const dw = iw * s, dh = ih * s;
    ctx.drawImage(img, x + (w - dw) / 2, y + (h - dh) / 2, dw, dh);
    ctx.restore();
  }

  /* ================= ASSETS ================= */
  const tileDog = new Image(), tileCow = new Image(), tileMountains = new Image(), tileSteak = new Image();
  tileDog.src = TILE_DOG_SRC; tileCow.src = TILE_COW_SRC;
  tileMountains.src = TILE_MOUNTAINS_SRC; tileSteak.src = TILE_STEAK_SRC;

  /* ================= AUDIO (musik asli dari video) ================= */
  const AudioEngine = {
    ctx: null, masterGain: null, monitorGain: null, compressor: null,
    soundtrackEl: null, soundtrackGain: null, soundtrackReady: false,
    isInitialized: false, isMuted: false, userVolume: 0.85,
    init: function () {
      if (this.isInitialized) return;
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      this.ctx = new AC();
      this.compressor = this.ctx.createDynamicsCompressor();
      this.compressor.threshold.setValueAtTime(-14, this.ctx.currentTime);
      this.compressor.ratio.setValueAtTime(4, this.ctx.currentTime);
      this.masterGain = this.ctx.createGain();
      this.masterGain.gain.setValueAtTime(0.9, this.ctx.currentTime);
      this.monitorGain = this.ctx.createGain();
      this.monitorGain.gain.setValueAtTime(this.userVolume, this.ctx.currentTime);
      this.compressor.connect(this.masterGain);
      this.masterGain.connect(this.monitorGain);
      this.monitorGain.connect(this.ctx.destination);
      const dest = this.ctx.createMediaStreamDestination();
      this.masterGain.connect(dest);
      this.exportDest = dest;
      // Soundtrack
      const el = document.createElement("audio");
      el.preload = "auto"; el.src = SOUNDTRACK_SRC; el.loop = false;
      this.soundtrackEl = el;
      try {
        const src = this.ctx.createMediaElementSource(el);
        this.soundtrackGain = this.ctx.createGain();
        this.soundtrackGain.gain.setValueAtTime(0.9, this.ctx.currentTime);
        src.connect(this.soundtrackGain);
        this.soundtrackGain.connect(this.compressor);
      } catch (_) { this.soundtrackEl = null; }
      el.addEventListener("canplaythrough", () => { this.soundtrackReady = true; }, { once: true });
      this.isInitialized = true;
    },
    ensure: async function () {
      this.init();
      if (!this.soundtrackEl) return false;
      if (this.ctx && this.ctx.state === "suspended") { try { await this.ctx.resume(); } catch (_) {} }
      if (this.soundtrackReady || this.soundtrackEl.readyState >= 3) return true;
      try {
        await Promise.race([
          new Promise((res) => this.soundtrackEl.addEventListener("canplaythrough", res, { once: true })),
          new Promise((res) => setTimeout(res, 4000))
        ]);
      } catch (_) {}
      return this.soundtrackReady || this.soundtrackEl.readyState >= 3;
    },
    play: function (t) {
      if (!this.soundtrackEl) return;
      try {
        this.soundtrackEl.currentTime = clamp(t || 0, 0, SOUNDTRACK_DURATION - 0.1);
        const pr = this.soundtrackEl.play();
        if (pr && pr.catch) pr.catch(() => {});
      } catch (_) {}
    },
    pause: function () { if (this.soundtrackEl) { try { this.soundtrackEl.pause(); } catch (_) {} } },
    seek: function (t) {
      if (!this.soundtrackEl) return;
      try { this.soundtrackEl.currentTime = clamp(t || 0, 0, SOUNDTRACK_DURATION - 0.1); } catch (_) {}
    },
    setVolume: function (v) {
      this.userVolume = clamp(v, 0, 1);
      if (this.monitorGain && this.ctx) {
        this.monitorGain.gain.setTargetAtTime(this.isMuted ? 0 : this.userVolume, this.ctx.currentTime, 0.03);
      }
    },
    toggleMute: function () {
      this.isMuted = !this.isMuted;
      if (this.monitorGain && this.ctx) {
        this.monitorGain.gain.setTargetAtTime(this.isMuted ? 0 : this.userVolume, this.ctx.currentTime, 0.03);
      }
      return this.isMuted;
    }
  };

  /* ================= SCENES ================= */
  const DARK = "#202124", GRAY = "#5f6368", LIGHT = "#9aa0a6";

  function sceneAlpha(t, start, end, fadeIn, fadeOut) {
    return smoothstep(start, start + fadeIn, t) * (1 - smoothstep(end - fadeOut, end, t));
  }

  // ---- SCENE 1: Intro + kartu Hi David (0.0–2.0) ----
  function drawScene1(ctx, t) {
    const a = sceneAlpha(t, 0, 2.0, 0.3, 0.35);
    if (a <= 0.005) return;
    const rise = (1 - easeOutQuint(clamp(t / 0.7, 0, 1))) * 26;

    // Judul Gemini + sparkle
    const titleA = easeOutCubic(clamp(t / 0.55, 0, 1)) * a;
    ctx.save();
    ctx.globalAlpha = titleA;
    drawTrackedText(ctx, "Gemini", CX - 40, 138 + rise, 1, DARK, "700 92px -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif");
    ctx.restore();
    drawSparkle(ctx, 872, 128 + rise, 30, titleA, t * 0.4);
    ctx.save();
    ctx.globalAlpha = easeOutCubic(clamp((t - 0.25) / 0.5, 0, 1)) * a;
    drawTrackedText(ctx, "Your personal assistant", CX, 212 + rise, 0.5, GRAY, "400 42px -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif");
    ctx.restore();

    // Kartu naik dari bawah, pinggir pelangi
    const cardProg = easeOutQuint(clamp((t - 0.45) / 0.7, 0, 1));
    const cardA = cardProg * a;
    if (cardA > 0.01) {
      const cw = 1000, ch = 330, cx0 = CX - cw / 2;
      const cy0 = 300 + (1 - cardProg) * 90;
      ctx.save();
      ctx.globalAlpha = cardA;
      // pinggir pelangi (stroke gradasi + blur tipis)
      ctx.shadowColor = "rgba(66,133,244,0.35)";
      ctx.shadowBlur = 24; ctx.shadowOffsetY = 6;
      roundRectPath(ctx, cx0, cy0, cw, ch, 40);
      ctx.strokeStyle = rainbowGradient(ctx, cx0, cy0, cx0 + cw, cy0 + ch);
      ctx.lineWidth = 7; ctx.stroke();
      ctx.shadowColor = "transparent"; ctx.shadowBlur = 0; ctx.shadowOffsetY = 0;
      roundRectPath(ctx, cx0, cy0, cw, ch, 40);
      ctx.fillStyle = "#ffffff"; ctx.fill();
      ctx.restore();

      ctx.save();
      ctx.globalAlpha = cardA;
      drawSparkle(ctx, cx0 + 78, cy0 + 62, 17, 1, 0);
      drawTrackedText(ctx, "Hi David", cx0 + 108, cy0 + 62, 0, DARK, "500 34px -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif", "left");
      drawTrackedText(ctx, "Where should we start?", cx0 + 78, cy0 + 122, 0, DARK, "700 46px -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif", "left");
      // Pill input
      const px = cx0 + 48, py = cy0 + 168, pw = cw - 96, ph = 96;
      roundRectPath(ctx, px, py, pw, ph, 48);
      ctx.fillStyle = "#f8f9fa"; ctx.fill();
      ctx.strokeStyle = "rgba(60,64,67,0.12)"; ctx.lineWidth = 1.5; ctx.stroke();
      drawTrackedText(ctx, "Ask Gemini", px + 36, py + ph / 2 - 14, 0, "#80868b", "400 34px -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif", "left");
      // baris bawah pill
      ctx.font = "500 26px -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif";
      ctx.fillStyle = "#80868b"; ctx.textAlign = "left"; ctx.textBaseline = "middle";
      ctx.fillText("✕", px + 36, py + ph - 22);
      ctx.fillText("Tools", px + 78, py + ph - 22);
      ctx.textAlign = "right";
      ctx.fillText("Fast  ⌄", px + pw - 90, py + ph - 22);
      ctx.restore();
    }
  }

  // ---- SCENE 2: Ask Gemini + kartu Overview / Deep dive (2.0–3.2) ----
  function drawScene2(ctx, t) {
    const a = sceneAlpha(t, 2.0, 3.2, 0.25, 0.3);
    if (a <= 0.005) return;
    const lt = t - 2.0;

    // Pill "Ask Gemini"
    const pillProg = easeOutQuint(clamp(lt / 0.4, 0, 1));
    ctx.save();
    ctx.globalAlpha = pillProg * a;
    const pw = 300, ph = 76, px = CX - pw / 2, py = 96 + (1 - pillProg) * 30;
    shadowCard(ctx, px, py, pw, ph, 38, "#ffffff", 1);
    ctx.strokeStyle = "rgba(60,64,67,0.10)"; ctx.lineWidth = 1.5;
    roundRectPath(ctx, px, py, pw, ph, 38); ctx.stroke();
