  // ---- SCENE 8: Create / Write / Learn / With Gemini (15.2–22.33) ----
  function drawScene8(ctx, t) {
    if (t < 15.2) return;
    const lt = t - 15.2;
    const words = [
      { text: "Create", start: 0.0, end: 1.5 },
      { text: "Write", start: 1.5, end: 3.0 },
      { text: "Learn", start: 3.0, end: 4.5 },
      { text: "With Gemini", start: 4.5, end: 6.6 }
    ];
    words.forEach((w) => {
      const local = lt - w.start;
      if (local < 0 || local > (w.end - w.start) + 0.4) return;
      const fadeIn = smoothstep(0, 0.35, local);
      const fadeOut = 1 - smoothstep((w.end - w.start) - 0.45, (w.end - w.start) + 0.1, local);
      const a = fadeIn * fadeOut;
      if (a <= 0.01) return;
      const scale = 0.92 + 0.08 * easeOutQuint(clamp(local / 0.5, 0, 1));
      ctx.save();
      ctx.globalAlpha = a;
      ctx.translate(CX, CY);
      ctx.scale(scale, scale);
      ctx.font = "500 88px -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif";
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      if (w.text === "With Gemini") {
        const wW = ctx.measureText("With ").width;
        const wAll = ctx.measureText(w.text).width;
        ctx.textAlign = "left";
        ctx.fillStyle = GRAY;
        ctx.fillText("With", -wAll / 2, 0);
        ctx.fillStyle = DARK;
        ctx.fillText("Gemini", -wAll / 2 + wW, 0);
        drawSparkle(ctx, -wAll / 2 - 52, 0, 22, 1, 0);
      } else {
        ctx.fillStyle = DARK;
        ctx.fillText(w.text, 0, 0);
      }
      ctx.restore();
    });
    // Fade ke putih di akhir
    const endFade = smoothstep(6.6, 7.13, lt);
    if (endFade > 0.01) {
      ctx.save(); ctx.globalAlpha = endFade;
      ctx.fillStyle = "#ffffff"; ctx.fillRect(0, 0, WIDTH, HEIGHT);
      ctx.restore();
    }
  }

  /* ================= MASTER RENDER ================= */
  const canvas = document.getElementById("stageCanvas");
  const ctx = canvas.getContext("2d");

  function renderFrame(t) {
    // Latar putih + blob pelangi lembut
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, WIDTH, HEIGHT);
    softBlob(ctx, 180 + Math.sin(t * 0.12) * 30, 620, 340, "rgba(52,168,83,0.20)", 1);
    softBlob(ctx, 1120 + Math.cos(t * 0.10) * 30, 90, 320, "rgba(66,133,244,0.16)", 1);
    softBlob(ctx, 640, 700, 420, "rgba(155,114,203,0.14)", 1);
    softBlob(ctx, 150, 120, 260, "rgba(251,188,4,0.10)", 1);

    drawScene1(ctx, t);
    drawScene2(ctx, t);
    drawScene3(ctx, t);
    drawScene4(ctx, t);
    drawScene5(ctx, t);
    drawScene6(ctx, t);
    drawScene7(ctx, t);
    drawScene8(ctx, t);
  }

  /* ================= PLAYER ================= */
  const playBtn = document.getElementById("playBtn");
  const replayBtn = document.getElementById("replayBtn");
  const scrubber = document.getElementById("scrubber");
  const timeLabel = document.getElementById("timeLabel");
  const muteBtn = document.getElementById("muteBtn");
  const sceneRow = document.getElementById("sceneRow");

  let currentTime = 0.0, isPlaying = false, isExporting = false;
  let rafId = null, lastPerf = 0;
  let exportFrameIndex = 0, exportChunkCount = 0;
  let currentBlobUrl = null, masterWebmBlob = null, masterMp4BlobUrl = null;
  let isConvertingMp4 = false, ffmpegInstance = null, ffmpegLoaded = false;
  let activeMediaRecorder = null, activeVideoTrack = null;

  SCENES.forEach((s) => {
    const b = document.createElement("button");
    b.type = "button"; b.className = "scene-chip"; b.textContent = s.name;
    b.addEventListener("click", () => { seekTo(s.start + 0.01); });
    sceneRow.appendChild(b);
  });
  const sceneChips = Array.from(sceneRow.querySelectorAll(".scene-chip"));

  function updateUI() {
    scrubber.value = String(currentTime);
    timeLabel.textContent = currentTime.toFixed(2) + "s / " + DURATION.toFixed(2) + "s";
    playBtn.textContent = isPlaying ? "⏸ Pause" : "▶ Play";
    const idx = SCENES.findIndex((s) => currentTime >= s.start && currentTime < s.end);
    sceneChips.forEach((c, i) => c.classList.toggle("active", i === idx));
  }

  function tick(now) {
    if (!isPlaying) return;
    const dt = Math.min((now - lastPerf) / 1000, 0.1);
    lastPerf = now;
    currentTime += dt;
    if (currentTime >= DURATION) {
      currentTime = DURATION;
      renderFrame(currentTime);
      updateUI();
      pausePlayback(true);
      return;
    }
    renderFrame(currentTime);
    updateUI();
    rafId = requestAnimationFrame(tick);
  }

  async function startPlayback() {
    await AudioEngine.ensure();
    if (currentTime >= DURATION - 0.01) currentTime = 0;
    AudioEngine.play(currentTime);
    isPlaying = true;
    lastPerf = performance.now();
    updateUI();
    rafId = requestAnimationFrame(tick);
  }

  function pausePlayback(ended) {
    isPlaying = false;
    AudioEngine.pause();
    if (rafId) cancelAnimationFrame(rafId);
    rafId = null;
    if (!ended) updateUI();
  }

  function seekTo(t) {
    currentTime = clamp(t, 0, DURATION);
    AudioEngine.seek(currentTime);
    if (!isPlaying) { renderFrame(currentTime); updateUI(); }
  }

  playBtn.addEventListener("click", () => { if (isPlaying) pausePlayback(false); else startPlayback(); });
  replayBtn.addEventListener("click", () => { pausePlayback(false); seekTo(0); startPlayback(); });
  scrubber.addEventListener("input", (e) => { pausePlayback(false); seekTo(parseFloat(e.target.value)); });
  muteBtn.addEventListener("click", () => {
    AudioEngine.init();
    const muted = AudioEngine.toggleMute();
    muteBtn.textContent = muted ? "🔇 Mute" : "🔊 " + Math.round(AudioEngine.userVolume * 100) + "%";
  });

  /* ================= EXPORT (WebM master + MP4 via ffmpeg.wasm) ================= */
  const exportBtn = document.getElementById("exportBtn");
  const convertMp4Btn = document.getElementById("convertMp4Btn");
  const downloadWebm = document.getElementById("downloadWebm");
  const downloadMp4 = document.getElementById("downloadMp4");
  const progressFill = document.getElementById("progressFill");
  const statusMsg = document.getElementById("statusMsg");
  const pctMsg = document.getElementById("pctMsg");
  const mp4StatusMsg = document.getElementById("mp4StatusMsg");

  function detectBestExportCodec() {
    const cands = [
      { mimeType: 'video/webm;codecs=vp9,opus', ext: "webm" },
      { mimeType: 'video/webm;codecs=vp8,opus', ext: "webm" },
      { mimeType: "video/webm", ext: "webm" }
    ];
    for (const c of cands) {
      if (window.MediaRecorder && MediaRecorder.isTypeSupported(c.mimeType)) return c;
    }
    return { mimeType: "", ext: "webm" };
  }

  async function startVideoExport() {
    if (isExporting) return;
    statusMsg.textContent = "Memverifikasi aset & audio...";
    await AudioEngine.ensure();
    const codecInfo = detectBestExportCodec();
    if (!codecInfo.mimeType || typeof canvas.captureStream !== "function") {
      statusMsg.textContent = "MediaRecorder/captureStream tidak didukung di browser ini.";
      return;
    }
    if (currentBlobUrl) { URL.revokeObjectURL(currentBlobUrl); currentBlobUrl = null; }
    if (masterMp4BlobUrl) { URL.revokeObjectURL(masterMp4BlobUrl); masterMp4BlobUrl = null; }
    downloadWebm.classList.remove("ready");
    downloadMp4.classList.remove("ready");
    convertMp4Btn.disabled = true;
    mp4StatusMsg.textContent = "Merekam master WebM baru — convert MP4 tersedia setelah master selesai.";

    isExporting = true;
    exportFrameIndex = 0;
    exportChunkCount = 0;
    exportBtn.disabled = true;
    convertMp4Btn.disabled = true;
    playBtn.disabled = true;
    replayBtn.disabled = true;
    scrubber.disabled = true;
    exportBtn.textContent = "Merekam Master 30 FPS...";
    document.getElementById("enginePill").textContent = "REC · 1280×720 30FPS (WEBM)";

    currentTime = 0.0;
    renderFrame(0.0);
    const canvasStream = canvas.captureStream(0);
    activeVideoTrack = canvasStream.getVideoTracks()[0] || null;
    const audioTracks = AudioEngine.exportDest ? AudioEngine.exportDest.stream.getAudioTracks() : [];
    const combinedStream = new MediaStream([...canvasStream.getVideoTracks(), ...audioTracks]);

    const recordedChunks = [];
    try {
      activeMediaRecorder = new MediaRecorder(combinedStream, {
        mimeType: codecInfo.mimeType,
        videoBitsPerSecond: 12000000,
        audioBitsPerSecond: 192000
      });
    } catch (_) {
      activeMediaRecorder = new MediaRecorder(combinedStream);
    }
    activeMediaRecorder.ondataavailable = (e) => {
      if (e.data && e.data.size > 0) { recordedChunks.push(e.data); exportChunkCount++; }
    };
    activeMediaRecorder.onerror = () => {
      statusMsg.textContent = "Terjadi kesalahan saat merekam. Silakan coba lagi.";
      cleanupExportState(canvasStream);
    };
    activeMediaRecorder.onstop = () => {
      const blob = new Blob(recordedChunks, { type: codecInfo.mimeType || "video/webm" });
      masterWebmBlob = blob;
      currentBlobUrl = URL.createObjectURL(blob);
      const sizeMB = (blob.size / (1024 * 1024)).toFixed(2);
      downloadWebm.href = currentBlobUrl;
      downloadWebm.download = "gemini_recreation.webm";
      downloadWebm.textContent = "Download WebM Master (" + sizeMB + " MB)";
      downloadWebm.classList.add("ready");
      statusMsg.textContent = "Selesai (" + sizeMB + " MB, 1280×720, 30FPS + Audio · " + exportFrameIndex + "/" + TOTAL_FRAMES + " frame, " + exportChunkCount + " chunk)";
      pctMsg.textContent = "100%";
      if (exportFrameIndex < TOTAL_FRAMES) {
        statusMsg.textContent += " — PERINGATAN: hanya " + exportFrameIndex + " frame terekam, export mungkin terpotong.";
        mp4StatusMsg.textContent = "Master terpotong — jangan convert ke MP4 dari file ini, export WebM ulang.";
      } else {
        mp4StatusMsg.textContent = "Memverifikasi durasi master WebM...";
        const probe = document.createElement("video");
        probe.preload = "metadata"; probe.muted = true; probe.src = currentBlobUrl;
        probe.onloadedmetadata = () => {
          const d = probe.duration;
          if (Number.isFinite(d)) {
            statusMsg.textContent += " · durasi file " + d.toFixed(2) + "s";
            if (d < DURATION - 0.5) {
              mp4StatusMsg.textContent = "Master hanya " + d.toFixed(2) + " detik — jangan convert, export WebM ulang dengan tab tetap di depan.";
            } else {
              convertMp4Btn.disabled = false;
              mp4StatusMsg.textContent = "Master OK (" + d.toFixed(2) + "s, " + sizeMB + " MB) — siap convert ke MP4.";
            }
          } else {
            convertMp4Btn.disabled = false;
            mp4StatusMsg.textContent = "Durasi tidak terbaca, tapi frame lengkap — MP4 bisa dicoba.";
          }
        };
        probe.onerror = () => {
          convertMp4Btn.disabled = false;
          mp4StatusMsg.textContent = "Verifikasi durasi gagal dibaca — MP4 bisa dicoba.";
        };
      }
      cleanupExportState(canvasStream);
      downloadWebm.click();
    };

    activeMediaRecorder.start(500);
    AudioEngine.play(0);
    // Loop export: 1 frame per tick, frame-index driven (bukan jam audio)
    function exportTick() {
      if (!isExporting) return;
      if (exportFrameIndex >= TOTAL_FRAMES) {
        currentTime = DURATION;
        renderFrame(currentTime);
        if (activeVideoTrack && typeof activeVideoTrack.requestFrame === "function") {
          try { activeVideoTrack.requestFrame(); } catch (_) {}
        }
        finishVideoExport();
        return;
      }
      currentTime = exportFrameIndex / EXPORT_FPS;
      renderFrame(currentTime);
      updateUI();
      const pct = Math.round((exportFrameIndex / TOTAL_FRAMES) * 100);
      progressFill.style.width = pct + "%";
      pctMsg.textContent = pct + "%";
      statusMsg.textContent = "Merekam 30FPS (frame " + exportFrameIndex + "/" + TOTAL_FRAMES + " · " + currentTime.toFixed(1) + "s / " + DURATION.toFixed(2) + "s)...";
      if (activeVideoTrack && typeof activeVideoTrack.requestFrame === "function") {
        try { activeVideoTrack.requestFrame(); } catch (_) {}
      }
      exportFrameIndex++;
      setTimeout(exportTick, 0);
    }
    exportTick();
  }

  function finishVideoExport() {
    isPlaying = false;
    AudioEngine.pause();
    if (activeMediaRecorder && activeMediaRecorder.state !== "inactive") {
      try { activeMediaRecorder.requestData(); } catch (_) {}
      setTimeout(() => {
        if (activeMediaRecorder && activeMediaRecorder.state !== "inactive") {
          activeMediaRecorder.stop();
        }
      }, 700);
    }
  }

  function cleanupExportState(canvasStream) {
    isExporting = false;
    activeVideoTrack = null;
    exportBtn.disabled = false;
    playBtn.disabled = false;
    replayBtn.disabled = false;
    scrubber.disabled = false;
    exportBtn.textContent = "Export WebM Master (22.33s)";
    document.getElementById("enginePill").textContent = "EXPORT SIAP · 22.33S";
    if (canvasStream) canvasStream.getVideoTracks().forEach((tr) => tr.stop());
  }

  async function convertMasterToMp4() {
    if (isConvertingMp4 || isExporting) return;
    if (!masterWebmBlob) {
      mp4StatusMsg.textContent = "Belum ada master WebM — tekan Export WebM Master dulu.";
      return;
    }
    isConvertingMp4 = true;
    convertMp4Btn.disabled = true;
    exportBtn.disabled = true;
    convertMp4Btn.textContent = "Converting ke MP4...";
    progressFill.style.width = "5%";
    pctMsg.textContent = "5%";
    try {
      if (!ffmpegLoaded) {
        mp4StatusMsg.textContent = "Memuat mesin convert MP4 (ffmpeg.wasm ~31 MB, sekali saja, butuh internet)...";
        const ffmpegMod = await import("https://cdn.jsdelivr.net/npm/@ffmpeg/ffmpeg@0.12.15/+esm");
        const utilMod = await import("https://cdn.jsdelivr.net/npm/@ffmpeg/util@0.12.2/+esm");
        ffmpegInstance = new ffmpegMod.FFmpeg();
        ffmpegInstance.on("progress", ({ progress, time }) => {
          const p = progress != null ? progress : (time ? time / (DURATION * 1000000) : 0);
          const pct = Math.round(clamp(p, 0, 1) * 100);
          progressFill.style.width = pct + "%";
          pctMsg.textContent = pct + "%";
          mp4StatusMsg.textContent = "Converting ke MP4... " + pct + "%";
        });
        const baseURL = "https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.10/dist/umd";
        await ffmpegInstance.load({
          coreURL: await utilMod.toBlobURL(baseURL + "/ffmpeg-core.js", "text/javascript"),
          wasmURL: await utilMod.toBlobURL(baseURL + "/ffmpeg-core.wasm", "application/wasm")
        });
        ffmpegLoaded = true;
      }
      mp4StatusMsg.textContent = "Menulis master WebM ke mesin convert...";
      const masterBytes = new Uint8Array(await masterWebmBlob.arrayBuffer());
      await ffmpegInstance.writeFile("master.webm", masterBytes);
      mp4StatusMsg.textContent = "Transcode ke MP4 (H.264 CRF 16 + AAC 192k, 1280×720 30fps)...";
      await ffmpegInstance.exec([
        "-i", "master.webm",
        "-c:v", "libx264", "-crf", "16", "-preset", "medium",
        "-pix_fmt", "yuv420p", "-r", "30",
        "-c:a", "aac", "-b:a", "192k",
        "-movflags", "+faststart", "-y", "output.mp4"
      ]);
      const data = await ffmpegInstance.readFile("output.mp4");
      if (!data || data.length === 0) throw new Error("file MP4 hasil convert kosong");
      const mp4Blob = new Blob([data], { type: "video/mp4" });
      if (masterMp4BlobUrl) URL.revokeObjectURL(masterMp4BlobUrl);
      masterMp4BlobUrl = URL.createObjectURL(mp4Blob);
      const sizeMB = (mp4Blob.size / (1024 * 1024)).toFixed(2);
      downloadMp4.href = masterMp4BlobUrl;
      downloadMp4.download = "gemini_recreation.mp4";
      downloadMp4.textContent = "Download MP4 (" + sizeMB + " MB .mp4)";
      downloadMp4.classList.add("ready");
      const probe = document.createElement("video");
      probe.preload = "metadata"; probe.muted = true; probe.src = masterMp4BlobUrl;
      probe.onloadedmetadata = () => {
        const d = probe.duration;
        if (Number.isFinite(d)) {
          mp4StatusMsg.textContent = "Selesai MP4 (" + sizeMB + " MB, durasi file " + d.toFixed(2) + "s, H.264 CRF 16 + AAC 192k).";
          if (d < DURATION - 0.5) mp4StatusMsg.textContent += " PERINGATAN: durasi MP4 pendek — coba convert ulang.";
        } else {
          mp4StatusMsg.textContent = "Selesai MP4 (" + sizeMB + " MB, H.264 CRF 16 + AAC 192k).";
        }
      };
      probe.onerror = () => { mp4StatusMsg.textContent = "Selesai MP4 (" + sizeMB + " MB, H.264 CRF 16 + AAC 192k)."; };
      try { await ffmpegInstance.deleteFile("master.webm"); } catch (_) {}
      try { await ffmpegInstance.deleteFile("output.mp4"); } catch (_) {}
      progressFill.style.width = "100%";
      pctMsg.textContent = "100%";
      downloadMp4.click();
    } catch (err) {
      mp4StatusMsg.textContent = "Gagal convert ke MP4: " + (err && err.message ? err.message : err) + ". WebM master tetap bisa diunduh. Alternatif offline: ffmpeg -i hasil.webm -c:v libx264 -crf 16 -c:a aac hasil.mp4";
      progressFill.style.width = "0%";
      pctMsg.textContent = "0%";
    } finally {
      isConvertingMp4 = false;
      convertMp4Btn.disabled = !masterWebmBlob;
      convertMp4Btn.textContent = "Convert ke MP4 (H.264)";
      exportBtn.disabled = false;
    }
  }

  exportBtn.addEventListener("click", startVideoExport);
  convertMp4Btn.addEventListener("click", convertMasterToMp4);

  /* ================= INIT ================= */
  renderFrame(0);
  updateUI();
})();
</script>
</body>
</html>
