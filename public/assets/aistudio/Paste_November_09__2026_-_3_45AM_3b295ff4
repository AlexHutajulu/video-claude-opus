      /* ==========================================================================
       * SYNCHRONIZED ORIGINAL AUDIO ENGINE (33.73 SECONDS)
       * ========================================================================== */
      class ChatGPTAudioEngine {
        constructor() {
          this.ctx = null;
          this.masterGain = null;
          this.monitorGain = null;
          this.exportDest = null;
          this.audioBuffer = null;
          this.activeSource = null;
          this.isInitialized = false;
          this.isMuted = false;
          this.userVolume = 0.9;
        }

        async init() {
          if (this.isInitialized && this.ctx) {
            if (this.ctx.state === "suspended") {
              try { await this.ctx.resume(); } catch (_) {}
            }
            return;
          }

          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioCtx();

          this.masterGain = this.ctx.createGain();
          this.masterGain.gain.setValueAtTime(1.0, this.ctx.currentTime);

          this.exportDest = this.ctx.createMediaStreamDestination();

          this.monitorGain = this.ctx.createGain();
          this.monitorGain.gain.setValueAtTime(this.isMuted ? 0 : this.userVolume, this.ctx.currentTime);

          this.masterGain.connect(this.exportDest);
          this.masterGain.connect(this.monitorGain);
          this.monitorGain.connect(this.ctx.destination);

          try {
            const binary = atob(ORIGINAL_AUDIO_B64);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) {
              bytes[i] = binary.charCodeAt(i);
            }
            this.audioBuffer = await this.ctx.decodeAudioData(bytes.buffer);
          } catch (_) {
            this.audioBuffer = null;
          }

          this.isInitialized = true;
          if (this.ctx.state === "suspended") {
            try { await this.ctx.resume(); } catch (_) {}
          }
        }

        startBufferAt(offsetSec) {
          this.stopBuffer();
          if (!this.ctx || !this.audioBuffer) return;

          if (offsetSec < this.audioBuffer.duration - 0.05) {
            const src = this.ctx.createBufferSource();
            src.buffer = this.audioBuffer;
            src.connect(this.masterGain);
            src.start(0, clamp(offsetSec, 0, this.audioBuffer.duration - 0.05));
            this.activeSource = src;
          }
        }

        stopBuffer() {
          if (this.activeSource) {
            try { this.activeSource.stop(); } catch (_) {}
            try { this.activeSource.disconnect(); } catch (_) {}
            this.activeSource = null;
          }
        }

        setVolume(val) {
          this.userVolume = clamp(val, 0, 1);
          if (this.monitorGain && this.ctx && !this.isMuted) {
            this.monitorGain.gain.setTargetAtTime(this.userVolume, this.ctx.currentTime, 0.02);
          }
        }

        setMute(muted) {
          this.isMuted = Boolean(muted);
          if (this.monitorGain && this.ctx) {
            this.monitorGain.gain.setTargetAtTime(this.isMuted ? 0 : this.userVolume, this.ctx.currentTime, 0.02);
          }
        }
      }

