              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="8"></circle></svg>
              <span id="exportBtnText">Export Video (33.7s)</span>
            </button>

            <a id="downloadVideoLink" class="download-btn" href="#top" download="chatgpt_promo_video.webm">
              <span id="downloadBtnText">Download Video</span>
