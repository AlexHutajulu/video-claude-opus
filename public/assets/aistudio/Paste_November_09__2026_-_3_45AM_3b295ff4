  <script>
    (function () {
      "use strict";

      const WIDTH = 1920;
      const HEIGHT = 1080;
      const CX = WIDTH * 0.5;
      const CY = HEIGHT * 0.5;
      const DURATION = 33.73;
      const EXPORT_FPS = 30;
      const EXPORT_FRAME_MS = 1000 / EXPORT_FPS;

      // Embedded Visual & Audio Assets from ssstik.io_1794166316613.mp4
      const B64_CHATGPT = "data:image/png;base64,";
      const B64_GEMINI = "data:image/png;base64,";
      const B64_LOOP = "data:image/png;base64,";
      const B64_COPILOT = "data:image/png;base64,";
      const B64_CLAUDE = "data:image/png;base64,";
      const B64_MOUNTAIN = "data:image/jpeg;base64,";
      const ORIGINAL_AUDIO_B64 = "";

      document.getElementById("headerLogoImg").src = B64_CHATGPT;

      function loadImg(src) {
        const img = new Image();
        img.decoding = "sync";
        img.src = src;
        return img;
      }

      const imgChatGPT = loadImg(B64_CHATGPT);
      const imgGemini = loadImg(B64_GEMINI);
      const imgLoop = loadImg(B64_LOOP);
      const imgCopilot = loadImg(B64_COPILOT);
      const imgClaude = loadImg(B64_CLAUDE);
      const imgMountain = loadImg(B64_MOUNTAIN);

      const SCENES = [
        { id: 1, name: "SCENE 01 — AI MODEL DOCK", start: 0.0, end: 3.2 },
        { id: 2, name: "SCENE 02 — CURSOR SELECTION", start: 3.2, end: 8.8 },
        { id: 3, name: "SCENE 03 — PLANETARY HORIZON", start: 8.8, end: 13.8 },
        { id: 4, name: "SCENE 04 — ASK CHATGPT BAR", start: 13.8, end: 17.8 },
        { id: 5, name: "SCENE 05 — GENERATE LAKE PHOTO", start: 17.8, end: 22.8 },
        { id: 6, name: "SCENE 06 — UNLEASH YOUR CREAYIVITY", start: 22.8, end: 29.0 },
        { id: 7, name: "SCENE 07 — CHATGPT OUTRO", start: 29.0, end: 33.75 }
      ];

      const clamp = (v, min, max) => (v < min ? min : v > max ? max : v);
      const lerp = (a, b, t) => a + (b - a) * t;
      const smoothstep = (e0, e1, x) => {
        const t = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
        return t * t * (3.0 - 2.0 * t);
      };
      const easeOutCubic = (t) => {
        const inv = 1.0 - clamp(t, 0.0, 1.0);
        return 1.0 - inv * inv * inv;
      };
      const easeOutBack = (t) => {
        const x = clamp(t, 0.0, 1.0);
        const c1 = 1.70158;
        const c3 = c1 + 1;
        return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2);
      };
      const easeInOutCubic = (t) => {
        const x = clamp(t, 0.0, 1.0);
        return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
      };

      /* ==========================================================================
       * MASTER RENDER ENGINE (REPRODUCES ALL 33.73 SECONDS OF THE VIDEO)
       * ========================================================================== */
      class ChatGPTVideoRenderer {
        constructor(canvas) {
          this.canvas = canvas;
          this.ctx = canvas.getContext("2d", { alpha: false });
          this.buildCornerFlareBackground();
        }

        buildCornerFlareBackground() {
          this.flareBgCanvas = document.createElement("canvas");
          this.flareBgCanvas.width = WIDTH;
          this.flareBgCanvas.height = HEIGHT;
          const ctx = this.flareBgCanvas.getContext("2d", { alpha: false });

          ctx.fillStyle = "#000000";
          ctx.fillRect(0, 0, WIDTH, HEIGHT);

          // Top-left bright lavender-blue radial lens flare
          const tlGrad = ctx.createRadialGradient(80, 40, 10, 120, 80, 820);
          tlGrad.addColorStop(0.0, "rgba(240, 245, 255, 0.96)");
          tlGrad.addColorStop(0.22, "rgba(185, 200, 255, 0.72)");
          tlGrad.addColorStop(0.52, "rgba(65, 85, 195, 0.34)");
          tlGrad.addColorStop(0.82, "rgba(18, 24, 72, 0.10)");
          tlGrad.addColorStop(1.0, "rgba(0, 0, 0, 0)");
          ctx.fillStyle = tlGrad;
          ctx.fillRect(0, 0, WIDTH, HEIGHT);

          // Bottom-right subtle indigo-blue lens flare
          const brGrad = ctx.createRadialGradient(WIDTH - 60, HEIGHT - 40, 10, WIDTH - 90, HEIGHT - 60, 560);
          brGrad.addColorStop(0.0, "rgba(145, 165, 255, 0.55)");
          brGrad.addColorStop(0.45, "rgba(45, 65, 165, 0.24)");
          brGrad.addColorStop(1.0, "rgba(0, 0, 0, 0)");
          ctx.fillStyle = brGrad;
          ctx.fillRect(0, 0, WIDTH, HEIGHT);
        }

        drawChatGPTEmblem(ctx, x, y, size, rotation, alpha = 1.0) {
          if (alpha <= 0.01 || size <= 1) return;
          ctx.save();
          ctx.globalAlpha = clamp(alpha, 0, 1);
          ctx.translate(x, y);
          ctx.rotate(rotation);
          if (imgChatGPT.complete && imgChatGPT.naturalWidth > 0) {
            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = "high";
            ctx.drawImage(imgChatGPT, -size * 0.5, -size * 0.5, size, size);
          }
          ctx.restore();
        }

        // Draws the crisp cartoon/OS Gloved Hand Pointer Cursor
        drawHandCursor(ctx, x, y, scale = 1.0, alpha = 1.0) {
          if (alpha <= 0.01) return;
          ctx.save();
          ctx.globalAlpha = clamp(alpha, 0, 1);
          ctx.translate(x, y);
          ctx.scale(scale, scale);

          ctx.shadowColor = "rgba(0, 0, 0, 0.65)";
          ctx.shadowBlur = 12;
          ctx.fillStyle = "#ffffff";
          ctx.strokeStyle = "#0a0a0c";
          ctx.lineWidth = 3.5;
          ctx.lineJoin = "round";

          // Index finger pointing up-left + 3 folded fingers + palm
          ctx.beginPath();
          ctx.roundRect(-8, -32, 14, 34, 7);
          ctx.fill();
          ctx.stroke();

          ctx.beginPath();
          ctx.roundRect(4, -18, 13, 24, 6);
          ctx.fill();
          ctx.stroke();

          ctx.beginPath();
          ctx.roundRect(15, -14, 13, 22, 6);
          ctx.fill();
          ctx.stroke();

          ctx.beginPath();
          ctx.roundRect(25, -9, 12, 20, 6);
          ctx.fill();
          ctx.stroke();

          // Thumb
          ctx.beginPath();
          ctx.moveTo(-8, -6);
          ctx.quadraticCurveTo(-24, -4, -22, 10);
          ctx.quadraticCurveTo(-18, 22, -6, 24);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();

          // Palm body
          ctx.beginPath();
          ctx.roundRect(-10, -4, 46, 34, 14);
          ctx.fill();
          ctx.stroke();

          // Two black back-of-hand lines (classic cartoon/Mac glove style seen in video)
          ctx.shadowBlur = 0;
          ctx.lineWidth = 2.6;
          ctx.beginPath();
          ctx.moveTo(4, 8); ctx.lineTo(4, 20);
          ctx.moveTo(14, 8); ctx.lineTo(14, 20);
          ctx.stroke();

          ctx.restore();
        }

        renderFrame(t) {
          const ctx = this.ctx;
          const time = clamp(t, 0.0, DURATION);

          if (time < 10.2) {
            this.renderScene01And02Dock(ctx, time);
          } else if (time < 14.2) {
            this.renderScene03PlanetaryHorizon(ctx, time);
          } else if (time < 22.85) {
            this.renderScene04And05PromptBar(ctx, time);
          } else if (time < 29.0) {
            this.renderScene06PhotoUnleash(ctx, time);
          } else {
            this.renderScene07FinalOutro(ctx, time);
          }
        }

        /* ----------------------------------------------------------------------
         * SCENE 01 & 02 (0.00s - 10.20s):
         * Glassmorphic Dock Expansion, 5 AI Logos, Hand Cursor Hovering Gemini & ChatGPT
         * ---------------------------------------------------------------------- */
        renderScene01And02Dock(ctx, time) {
          ctx.save();

          // Fade out corner flares between 8.6s and 9.8s as dock dissolves to pure black
          const flareAlpha = 1.0 - smoothstep(8.6, 9.8, time);
          ctx.fillStyle = "#000000";
          ctx.fillRect(0, 0, WIDTH, HEIGHT);
          if (flareAlpha > 0.01) {
            ctx.globalAlpha = flareAlpha;
            ctx.drawImage(this.flareBgCanvas, 0, 0);
            ctx.globalAlpha = 1.0;
          }

          // Camera zoom toward left side of dock when cursor inspects Gemini (5.0s -> 6.8s)
          const zoomInLeft = smoothstep(5.0, 5.8, time) * (1.0 - smoothstep(6.2, 7.1, time));
          const camScale = lerp(1.0, 1.48, zoomInLeft);
          const camShiftX = lerp(0, 290, zoomInLeft);
          const camShiftY = lerp(0, 18, zoomInLeft);

          ctx.translate(CX, CY);
          ctx.scale(camScale, camScale);
          ctx.translate(-CX + camShiftX, -CY + camShiftY);

          // Dock width expansion (0.0s -> 1.85s) & dissolve (8.4s -> 9.0s)
          const dockExpand = easeOutCubic(clamp(time / 1.75, 0.0, 1.0));
          const dockFade = smoothstep(0.05, 0.4, time) * (1.0 - smoothstep(8.35, 8.95, time));
          const dockW = lerp(520, 1140, dockExpand);
          const dockH = 176;
          const dockX = CX - dockW * 0.5;
          const dockY = CY - dockH * 0.5;

          if (dockFade > 0.01) {
            ctx.save();
            ctx.globalAlpha = dockFade;

            // Subtle dark glass fill
            const dGrad = ctx.createLinearGradient(dockX, dockY, dockX, dockY + dockH);
            dGrad.addColorStop(0.0, "rgba(255, 255, 255, 0.07)");
            dGrad.addColorStop(0.5, "rgba(15, 18, 28, 0.45)");
            dGrad.addColorStop(1.0, "rgba(255, 255, 255, 0.05)");
            ctx.fillStyle = dGrad;
            ctx.beginPath();
            ctx.roundRect(dockX, dockY, dockW, dockH, 28);
            ctx.fill();

            // Crisp metallic white-silver rim
            ctx.lineWidth = 2.4;
            ctx.strokeStyle = "rgba(235, 240, 255, 0.72)";
            ctx.stroke();

            // Clip icons inside the expanding dock
            ctx.beginPath();
            ctx.roundRect(dockX, dockY, dockW, dockH, 28);
            ctx.clip();

            // 5 AI Icons inside Dock:
            // Order: 1. Gemini (-455), 2. Loop (-235), 3. Copilot (+245), 4. Claude (+455)
            // (ChatGPT is drawn right after so it remains visible when the dock fades at 8.8s!)
            const iconAppear = smoothstep(0.55, 2.0, time);
            if (iconAppear > 0.01) {
              // 1. Gemini Icon (Left)
              const gemAppear = easeOutBack(clamp((time - 1.35) / 0.6, 0.0, 1.0));
              const gemHover = 1.0 + 0.14 * smoothstep(4.2, 4.7, time) * (1.0 - smoothstep(5.9, 6.4, time));
              const gemSize = 118 * gemAppear * gemHover;
              if (gemSize > 2 && imgGemini.complete) {
                ctx.drawImage(imgGemini, CX - 455 - gemSize * 0.5, CY - gemSize * 0.5, gemSize, gemSize);
              }

              // 2. Loop Icon (Mid-Left)
              const loopAppear = easeOutBack(clamp((time - 1.15) / 0.6, 0.0, 1.0));
              const loopSize = 122 * loopAppear;
              if (loopSize > 2 && imgLoop.complete) {
                ctx.drawImage(imgLoop, CX - 235 - loopSize * 0.5, CY - 8 - loopSize * 0.5, loopSize, loopSize);
              }

              // 4. Copilot Icon (Mid-Right)
              const copAppear = easeOutBack(clamp((time - 0.65) / 0.6, 0.0, 1.0));
              const copSize = 118 * copAppear;
              if (copSize > 2 && imgCopilot.complete) {
                ctx.drawImage(imgCopilot, CX + 245 - copSize * 0.5, CY - copSize * 0.5, copSize, copSize);
              }

              // 5. Claude Icon (Far-Right)
              const claudeAppear = easeOutBack(clamp((time - 0.45) / 0.6, 0.0, 1.0));
              const claudeSize = 98 * claudeAppear;
              if (claudeSize > 2 && imgClaude.complete) {
                ctx.drawImage(imgClaude, CX + 455 - claudeSize * 0.5, CY - claudeSize * 0.5, claudeSize, claudeSize);
              }
            }

            ctx.restore();
          }

          // 3. Center ChatGPT Icon (Persists after dock dissolves and spins at 9.2s - 10.2s)
          const gptAppear = easeOutBack(clamp((time - 1.55) / 0.65, 0.0, 1.0));
          if (gptAppear > 0.01) {
            // Scales up when selected at 7.0s - 8.6s, then settles to center size at 9.5s
            const selectBoost = smoothstep(6.7, 7.6, time) * (1.0 - smoothstep(9.0, 9.8, time));
            const gptSize = lerp(128, 178, selectBoost) * gptAppear;
            const gptSpin = smoothstep(9.1, 10.2, time) * Math.PI * 1.0;
            this.drawChatGPTEmblem(ctx, CX, CY + 4, gptSize, gptSpin, 1.0);
          }

          // Hand Pointer Cursor Choreography (2.8s -> 9.6s)
          if (time >= 2.8 && time <= 9.6) {
            const curAlpha = smoothstep(2.8, 3.15, time) * (1.0 - smoothstep(9.2, 9.6, time));
            let curX = CX + 42;
            let curY = CY + 24;

            if (time < 4.3) {
              // Move from ChatGPT to right side of Gemini
              const t1 = easeInOutCubic(clamp((time - 3.2) / 0.95, 0.0, 1.0));
              curX = lerp(CX + 42, CX - 405, t1);
              curY = lerp(CY + 24, CY + 36, t1);
            } else if (time < 6.1) {
              // Move onto left side of Gemini star and click
              const t2 = easeInOutCubic(clamp((time - 4.3) / 0.6, 0.0, 1.0));
              curX = lerp(CX - 405, CX - 485, t2);
              curY = lerp(CY + 36, CY + 28, t2);
            } else {
              // Glide back from Gemini to center of ChatGPT emblem
              const t3 = easeInOutCubic(clamp((time - 6.1) / 0.95, 0.0, 1.0));
              curX = lerp(CX - 485, CX - 6, t3);
              curY = lerp(CY + 28, CY + 18, t3);
            }

            const clickPress =
              (time > 4.9 && time < 5.3 ? 0.86 : 1.0) *
              (time > 7.4 && time < 7.8 ? 0.86 : 1.0) *
              (time > 8.8 && time < 9.2 ? 0.86 : 1.0);
            this.drawHandCursor(ctx, curX, curY, 1.15 * clickPress, curAlpha);
          }

          ctx.restore();
        }

        /* ----------------------------------------------------------------------
         * SCENE 03 (10.20s - 14.20s):
         * ChatGPT Logo Slides Left, Reveals "ChatGPT", Planetary Eclipse Horizon Rises
         * ---------------------------------------------------------------------- */
        renderScene03PlanetaryHorizon(ctx, time) {
          ctx.save();
          ctx.fillStyle = "#000000";
          ctx.fillRect(0, 0, WIDTH, HEIGHT);

          // Glowing Planetary Horizon Arc rising from bottom-left -> center
          const arcAppear = smoothstep(10.6, 12.2, time);
          if (arcAppear > 0.01) {
            const morphToPrompt = smoothstep(13.2, 14.1, time);
            const planetR = lerp(640, 1600, morphToPrompt);
            const planetX = lerp(CX - 180, CX, smoothstep(10.6, 12.6, time));
            const planetY = lerp(HEIGHT + 480, HEIGHT + 310, smoothstep(10.6, 12.6, time)) + morphToPrompt * 1150;

            // Outer lavender-blue atmospheric corona
            const corona = ctx.createRadialGradient(planetX, planetY, planetR - 20, planetX, planetY, planetR + 240);
            corona.addColorStop(0.0, "rgba(0, 0, 0, 1)");
            corona.addColorStop(0.08, `rgba(255, 255, 255, ${0.95 * arcAppear})`);
            corona.addColorStop(0.22, `rgba(175, 195, 255, ${0.55 * arcAppear})`);
            corona.addColorStop(0.55, `rgba(55, 85, 210, ${0.22 * arcAppear})`);
            corona.addColorStop(1.0, "rgba(0, 0, 0, 0)");

            ctx.fillStyle = corona;
            ctx.beginPath();
            ctx.arc(planetX, planetY, planetR + 240, 0, Math.PI * 2);
            ctx.fill();

            // Solid black planet body
            ctx.fillStyle = "#000000";
            ctx.beginPath();
            ctx.arc(planetX, planetY, planetR, 0, Math.PI * 2);
            ctx.fill();

            // Bright crisp white eclipse rim
            ctx.strokeStyle = `rgba(255, 255, 255, ${0.92 * arcAppear})`;
            ctx.lineWidth = 3.2;
            ctx.stroke();
          }

          // ChatGPT Emblem & "ChatGPT" Text Reveal
          const slideLeft = easeInOutCubic(clamp((time - 10.55) / 0.75, 0.0, 1.0));
          const liftUp = easeInOutCubic(clamp((time - 11.4) / 1.8, 0.0, 1.0));
          const logoX = lerp(CX, CX - 220, slideLeft);
          const logoY = lerp(CY, CY - 140, liftUp);
          const logoSize = lerp(128, 152, liftUp);
          const spin = (1.0 - easeOutCubic(clamp((time - 10.2) / 0.7, 0.0, 1.0))) * Math.PI * 0.6;

          this.drawChatGPTEmblem(ctx, logoX, logoY, logoSize, spin, 1.0);

          // Character-by-character "ChatGPT" reveal (10.85s -> 12.1s)
          const word = "ChatGPT";
          const charProg = clamp((time - 10.85) / 1.15, 0.0, 1.0);
          if (charProg > 0.01) {
            ctx.save();
            ctx.font = '500 108px "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
            ctx.textBaseline = "middle";
            ctx.textAlign = "left";

            let curX = logoX + logoSize * 0.62;
            for (let i = 0; i < word.length; i++) {
              const cAlpha = clamp((charProg * word.length - i), 0.0, 1.0);
              if (cAlpha > 0.01) {
                ctx.fillStyle = `rgba(255, 255, 255, ${cAlpha})`;
                ctx.fillText(word[i], curX, logoY + 4);
              }
              curX += ctx.measureText(word[i]).width;
            }
            ctx.restore();
          }

          ctx.restore();
        }

        /* ----------------------------------------------------------------------
         * SCENE 04 & 05 (13.80s - 22.85s):
         * Glowing Black Prompt Pill ("+ Ask ChatGPT" -> "+ Generate me lake photo |"),
         * Camera Pan Left-to-Right, and Hand Cursor Clicking Blue Up-Arrow Button
         * ---------------------------------------------------------------------- */
        renderScene04And05PromptBar(ctx, time) {
          ctx.save();
          ctx.fillStyle = "#000000";
          ctx.fillRect(0, 0, WIDTH, HEIGHT);

          // Soft atmospheric blue-white horizon cloud across the bottom third
          const horizGrad = ctx.createLinearGradient(0, CY + 20, 0, HEIGHT);
          horizGrad.addColorStop(0.0, "rgba(0, 0, 0, 0)");
          horizGrad.addColorStop(0.32, "rgba(75, 105, 225, 0.48)");
          horizGrad.addColorStop(0.62, "rgba(185, 205, 255, 0.85)");
          horizGrad.addColorStop(1.0, "rgba(245, 248, 255, 0.98)");
          ctx.fillStyle = horizGrad;
          ctx.fillRect(0, CY + 20, WIDTH, HEIGHT - (CY + 20));

          // Camera Zoom & Horizontal Pan during Scene 05 (17.5s -> 22.85s)
          // 17.5s -> 18.5s: Zoom in on left side of prompt bar
          // 18.5s -> 21.0s: Pan right across "Generate me lake photo" to the blue ↑ send button
          let camZoom = 1.0;
          let camPanX = 0;
          let camPanY = 0;
          if (time >= 17.4) {
            const zoomT = easeInOutCubic(clamp((time - 17.4) / 1.1, 0.0, 1.0));
            const panRightT = easeInOutCubic(clamp((time - 18.6) / 2.2, 0.0, 1.0));
            const pullBackT = easeInOutCubic(clamp((time - 22.2) / 0.65, 0.0, 1.0));

            camZoom = lerp(1.0, 1.56, zoomT) * lerp(1.0, 0.82, pullBackT);
            camPanX = lerp(0, 290, zoomT) - panRightT * 580;
            camPanY = lerp(0, -35, zoomT);
          }

          ctx.translate(CX, CY);
          ctx.scale(camZoom, camZoom);
          ctx.translate(-CX + camPanX, -CY + camPanY);

          // Top ChatGPT Lockup
          const logoX = CX - 220;
          const logoY = CY - 140;
          const logoSize = 152;
          this.drawChatGPTEmblem(ctx, logoX, logoY, logoSize, 0, 1.0);

          ctx.font = '500 108px "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
          ctx.fillStyle = "#ffffff";
          ctx.textBaseline = "middle";
          ctx.textAlign = "left";
          ctx.fillText("ChatGPT", logoX + logoSize * 0.62, logoY + 4);

          // Glowing Black Pill Prompt Bar
          const barW = 1040;
          const barH = 132;
          const barX = CX - barW * 0.5;
          const barY = CY + 26;
          const barR = barH * 0.5;

          ctx.save();
          ctx.shadowColor = "rgba(255, 255, 255, 0.82)";
          ctx.shadowBlur = 32;
          ctx.fillStyle = "#000000";
          ctx.beginPath();
          ctx.roundRect(barX, barY, barW, barH, barR);
          ctx.fill();

          ctx.lineWidth = 2.6;
          ctx.strokeStyle = "rgba(255, 255, 255, 0.92)";
          ctx.stroke();
          ctx.restore();

          // Left "+" Icon inside Prompt Bar (appears at 15.6s)
          const plusAlpha = smoothstep(15.5, 16.0, time);
          if (plusAlpha > 0.01) {
            const px = barX + 68;
            const py = barY + barH * 0.5;
            ctx.strokeStyle = `rgba(255, 255, 255, ${plusAlpha})`;
            ctx.lineWidth = 4.2;
            ctx.lineCap = "round";
            ctx.beginPath();
            ctx.moveTo(px - 18, py); ctx.lineTo(px + 18, py);
            ctx.moveTo(px, py - 18); ctx.lineTo(px, py + 18);
            ctx.stroke();
          }

          // Right Microphone Icon & Blue Send Circle Button (appear at 15.8s -> 17.0s)
          const rightIconsAlpha = smoothstep(15.8, 16.4, time);
          const micX = barX + barW - 142;
          const micY = barY + barH * 0.5;
          if (rightIconsAlpha > 0.01) {
            ctx.save();
            ctx.globalAlpha = rightIconsAlpha;
            ctx.fillStyle = "#ffffff";
            ctx.strokeStyle = "#ffffff";
            ctx.lineWidth = 3.2;
            ctx.beginPath();
            ctx.roundRect(micX - 7, micY - 18, 14, 22, 7);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(micX, micY - 4, 13, 0, Math.PI);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(micX, micY + 9); ctx.lineTo(micX, micY + 17);
            ctx.moveTo(micX - 8, micY + 17); ctx.lineTo(micX + 8, micY + 17);
            ctx.stroke();
            ctx.restore();
          }

          const sendBtnAlpha = smoothstep(16.6, 17.2, time);
          const sendX = barX + barW - 68;
          const sendY = barY + barH * 0.5;
          if (sendBtnAlpha > 0.01) {
            const clickScale = time > 21.6 && time < 22.3 ? 1.18 : 1.0;
            const btnR = lerp(18, 42, smoothstep(17.2, 18.6, time)) * clickScale;

            ctx.save();
            ctx.globalAlpha = sendBtnAlpha;
            ctx.fillStyle = "#1d4ed8";
